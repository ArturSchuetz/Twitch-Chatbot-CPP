# Lowercase login name of the Twitch account that owns the token.
TWITCH_BOT_USERNAME=your_bot_account

# User access token with chat:read and chat:edit scopes.
# A raw token or the oauth: prefixed form is accepted.
TWITCH_OAUTH_TOKEN=replace_me

# Comma-separated Twitch channel login names, without #.
TWITCH_CHANNELS=your_channel

# Optional public behavior configuration.
# TWITCH_CONFIG_FILE=config/bot.json

# Disabled by default because raw IRC includes usernames and chat content.
# TWITCH_LOG_RAW_IRC=false
